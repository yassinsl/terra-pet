{
  "name": "terra-pet",
  "productName": "Terra",
  "version": "0.1.0",
  "description": "Terra, a pixel-art desktop pet for macOS that reacts to Claude Code and the Claude desktop app.",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "hooks:install": "node scripts/install-hooks.js",
    "hooks:uninstall": "node scripts/uninstall-hooks.js",
    "mcp:install": "node scripts/install-mcp.js",
    "mcp:uninstall": "node scripts/uninstall-mcp.js",
    "icons": "node scripts/make-icons.js",
    "dist": "electron-builder --mac",
    "test": "node test/run.js"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.terrapet.app",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "package.json",
      "main.js",
      "preload.js",
      "listener.js",
      "reactions.js",
      "hook-installer.js",
      "mcp-installer.js",
      "json-file.js",
      "pet-commands.js",
      "mcp/terra-mcp.js",
      "window-state.js",
      "visibility.js",
      "claude-app.js",
      "renderer/**",
      "hooks/terra-hook.sh",
      "assets/trayTemplate.png",
      "assets/trayTemplate@2x.png",
      "Bot/spritesheet-x1.png",
      "Bot/reactions/emotes-only/*.png"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.entertainment",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "dmg": {
      "title": "Terra ${version}"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.5"
  }
}
